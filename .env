# Leave EMPTY in development. The site calls /api on its own address (http://localhost:5173)
# and the dev server forwards it to the API on http://localhost:3000 (vite.config.js).
# Do not put http://localhost:3000 here: sign-in cookies and the Google return address
# (API_PUBLIC_URL in the backend .env) belong to http://localhost:5173.
VITE_API_BASE_URL=

# Show "Continue with Google" (set to true only when the API has Google configured).
VITE_GOOGLE_SIGN_IN=true

PUSH_PROVIDER=fcm
FCM_SERVICE_ACCOUNT=./secrets/firebase-service-account.json
