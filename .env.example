# Copy to .env.local. These values are embedded in the public bundle —
# never put secrets here. Authentication is handled entirely by the T7fiz API.

# Origin of the T7fiz API (no path; a trailing /api is ignored). Leave empty to use the same origin:
#   development: the Vite dev server proxies /api to http://localhost:3000
#   production:  https://t7fiz.com serves the API under /api
VITE_API_BASE_URL=

# Live updates (WebSocket) origin, when the host forwards /api but not WebSockets (Vercel):
# the API's own origin, e.g. https://t7fiz-server.onrender.com. Empty = same as the API.
VITE_REALTIME_URL=

# Development only (not sent to the browser): where the dev server forwards /api.
# Must match PORT in t7fiz-backend/.env.
API_PROXY_TARGET=http://localhost:3000

# Show "Continue with Google" (set to true only when the API has Google configured).
VITE_GOOGLE_SIGN_IN=false

# Extra origins the browser may connect to, added to the Content-Security-Policy of production
# builds (space or comma separated). Only needed for a self-hosted voice server; LiveKit Cloud
# (*.livekit.cloud) is already allowed. Example: wss://voice.t7fiz.com
VITE_CSP_CONNECT_SRC=

# Push notifications (Firebase Cloud Messaging). All five are public web-app settings, not
# secrets. Firebase console → Project settings → General → Your apps → Web app → SDK setup
# (apiKey, projectId, messagingSenderId, appId), and Project settings → Cloud Messaging →
# Web Push certificates → Key pair (the VAPID key). Leave empty to keep push off.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
